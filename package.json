  "private": true,
  "type": "module",
  "description": "Lucro Certo — o painel (precificação, catálogo, estoque, vendas registradas e etiquetas)",
  "scripts": {
    "shared:sync": "node scripts/sincronizar-shared.mjs",
    "predev": "npm run shared:sync",
    "dev": "vite",
